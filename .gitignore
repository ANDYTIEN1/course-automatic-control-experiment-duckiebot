*.MP4
*.mov
*.MOV
*.avi
*.mkv
# Computed from data/raw/ by the scripts, so regenerated, never committed.
data/processed/
data/interim/
# Python environment and caches.
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
