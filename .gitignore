# =============================================================================
# Source: templates/gitignore/doc-build.gitignore
# Managed from the source file above.
# Comment out rules here if needed, but do not add or delete lines in this block.
# =============================================================================
# Generated document build outputs in doc/
#
# All build artefacts produced from sources in doc/ — manuscripts, reports,
# ADR exports — are built locally and must not be committed.  Every rule is
# scoped to doc/** so it cannot affect other directories.

# Per-chapter build dir used by some LaTeX setups
doc/*/build/

# Built PDFs and other output formats anywhere under doc/. PostScript is not
# ignored: a .ps file under doc/ is usually a figure a document includes.
doc/**/*.pdf
doc/**/*.dvi
doc/**/*.xdv

# Vouchers are received source documents, not build output (ADR-0055): a
# voucher collection is PDFs by nature — invoices, delivery notes, customs
# decisions — so the rule above would ignore the entire type. Negations work
# here because only files are excluded above, never a parent directory.
!doc/voucher/**/*.pdf
!doc/voucher_*/**/*.pdf

# A syllabus directory keeps the syllabus as filed, and a department files it
# as a PDF or an HTML export — that copy is the record, not build output, so
# it is exempt for the same reason a voucher is. The HTML negation matches
# nothing today, because no rule above ignores *.html under doc/; it is here
# so the two record formats stay exempt together if one is ever added.
!doc/syllabus_*/**/*.pdf
!doc/syllabus_*/**/*.html

# LaTeX intermediate files anywhere under doc/
doc/**/*.aux
doc/**/*.bbl
doc/**/*.bcf
doc/**/*.blg
doc/**/*.fdb_latexmk
doc/**/*.fls
doc/**/*.log
doc/**/*.out
doc/**/*.toc
doc/**/*.lof
doc/**/*.lot
doc/**/*.idx
doc/**/*.ilg
doc/**/*.ind
doc/**/*.nav
doc/**/*.run.xml
doc/**/*.snm
doc/**/*.synctex.gz
doc/**/*.vrb

# Additional engine/package temp outputs
doc/**/*.abs
doc/**/*.built

# pdfx PDF/X metadata sidecar (generated by submission tooling)
doc/**/*.xmpdata

# Submission-assembly tooling state files
doc/**/.submission-input-map
doc/**/.submission-manifest

# =============================================================================
# Source: templates/gitignore/doc-latex-packages.gitignore
# Managed from the source file above.
# Comment out rules here if needed, but do not add or delete lines in this block.
# =============================================================================
# LaTeX package intermediates compiled beside a source in doc/
#
# doc-build.gitignore covers the core LaTeX outputs; these come from
# packages a report may load, or from an interrupted biber or latexmk run.
# Every rule is scoped to doc/** so it cannot hide a data or code file.
# Extensions a student may also write by hand are left out: *.ist and *.xdy
# (index styles), *.ent (entity files) and *.pyg (Pygments styles).
doc/**/*.lol
doc/**/*.nlo
doc/**/*.nls
doc/**/*.glo
doc/**/*.gls
doc/**/*.glg
doc/**/_minted-*/
doc/**/*.fff
doc/**/*.ttt
doc/**/*.bbl-SAVE-ERROR
doc/**/*.auxlock
doc/**/*.tdo
doc/**/*.loa
doc/**/*.acn
doc/**/*.acr
doc/**/*.alg
doc/**/*.glsdefs
doc/**/*.thm
doc/**/*.sta
doc/**/*-blx.bib
doc/**/*.brf
doc/**/*.mtc
doc/**/*.mtc[0-9]*
doc/**/*.maf

# =============================================================================
# Source: templates/gitignore/figures-pdf-allow.gitignore
# Managed from the source file above.
# Comment out rules here if needed, but do not add or delete lines in this block.
# =============================================================================
# Allow PDF figures in a report's figures/ folder under doc/.
# doc-build.gitignore ignores every PDF under doc/ as build output, but a
# figure in doc/<report>/figures/ is a source the report includes, which a
# student project must commit. Negations only take effect when this block
# follows doc-build.gitignore, so keep it after it in the fragment list.
!doc/**/figures/**/*.pdf

