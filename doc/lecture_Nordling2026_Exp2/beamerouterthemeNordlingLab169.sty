% Title page
\defbeamertemplate*{title page}{NLTitle}{
  \vspace{-0.35cm}%
  %\vspace{-0.98cm}%
  \ifx\inserttitle\@empty\par
  \else{%
  %wd=\paperwidth-2\beamer@leftsidebar makes the box symmetric about
  %\paperwidth/2 (slide's geometric centre): with the template's natural
  %origin at slide-x = \beamer@leftsidebar, a width of
  %\paperwidth-2\beamer@leftsidebar puts the box's centre exactly on
  %\paperwidth/2. Centred content therefore lands on the slide centre
  %without touching the sidebar or the background canvas.
  \begin{beamercolorbox}[wd=\dimexpr\paperwidth-2\beamer@leftsidebar\relax,ht=1.98cm,dp=1ex,sep=0cm,center]{titlelike}
	\spaceskip=3pt
  	{\usebeamerfont{title}\par\inserttitle\par}
  \end{beamercolorbox}%
  }%
  \fi
  %Match the symmetric width for the subtitle/author/institute centring
  %environment so each of those lines also centres on the slide centre.
  \hsize=\dimexpr\paperwidth-2\beamer@leftsidebar\relax\linewidth=\hsize%
  \begin{centering}
  \vspace{0.25cm}
  \spaceskip=0pt
  \ifx\insertsubtitle\@empty\par
  \else{\par\usebeamercolor[fg]{title page title}\usebeamerfont{subtitle}\insertsubtitle\par}
  \fi
  \ifx\insertauthor\@empty\par
  \else{\par\usebeamercolor[fg]{normal text}\usebeamerfont{author}\insertauthor\par}
  \fi
  \ifx\insertinstitute\@empty\par
  \else{\par\usebeamercolor[fg]{normal text}\usebeamerfont{institute}\insertinstitute\par}
  \fi
  \ifx\insertdate\@empty\par
 % \else{\vspace{-0.1cm}\par\usebeamercolor[fg]{normal text}\usebeamerfont{date}\insertdate\par}
  \fi
  \end{centering}
  \vfill
}

% Frame title
%
% Content-independent vertical positioning: the title and subtitle are
% placed via TikZ overlay at absolute slide coordinates measured from
% (current page.north west). The frametitle template itself emits only a
% fixed-height \vbox that reserves the right amount of body space; the
% template's own output is the same height regardless of frame mode
% ([t]/[c]/[fragile]) or body content, so no vertical glue can be
% discarded.
\defbeamertemplate*{frametitle}{NL}[1][]{%frametitle for slide with/without CC
  \ifx\insertframetitle\@empty
    % No title: still reserve a small top margin so body doesn't crash
    % into the top edge.
    \vbox to0.4cm{}%
  \else
    \setbox\@tempboxa=\vbox{%
      \hsize=\dimexpr\paperwidth-\beamer@leftsidebar\relax
      \usebeamerfont{frametitle}\noindent\insertframetitle\par
    }%
    \begin{tikzpicture}[remember picture,overlay]
      \ifdim\ht\@tempboxa>0.7cm
        % Multi-line title: anchor first line ~0.2 cm from slide top
        % (half a cap height above the single-line anchor).
        \node[anchor=north west,inner sep=0pt,
              text width=\dimexpr\paperwidth-\beamer@leftsidebar-0.3cm\relax,
              align=left]
          at ([xshift=\beamer@leftsidebar,yshift=-0.2cm]current page.north west)
          {\usebeamercolor[fg]{frametitle}\usebeamerfont{frametitle}\insertframetitle};
      \else
        \ifx\insertframesubtitle\@empty
          % Single line, no subtitle: cap top at logo top (~0.4 cm).
          \node[anchor=north west,inner sep=0pt,
                text width=\dimexpr\paperwidth-\beamer@leftsidebar-0.3cm\relax,
                align=left]
            at ([xshift=\beamer@leftsidebar,yshift=-3mm]current page.north west)
            {\usebeamercolor[fg]{frametitle}\usebeamerfont{frametitle}\insertframetitle};
        \else
          % Single line with subtitle: lift title to ~0.2 cm; subtitle
          % anchored ~0.85 cm from slide top so the gap is ~half a
          % subtitle-line tall.
          \node[anchor=north west,inner sep=0pt,
                text width=\dimexpr\paperwidth-\beamer@leftsidebar-0.3cm\relax,
                align=left]
            at ([xshift=\beamer@leftsidebar,yshift=-0.2cm]current page.north west)
            {\usebeamercolor[fg]{frametitle}\usebeamerfont{frametitle}\insertframetitle};
          \node[anchor=north west,inner sep=0pt,
                text width=\dimexpr\paperwidth-\beamer@leftsidebar-0.3cm\relax,
                align=left]
            at ([xshift=\beamer@leftsidebar,yshift=-0.85cm]current page.north west)
            {\usebeamercolor[fg]{framesubtitle}\usebeamerfont{framesubtitle}\insertframesubtitle};
        \fi
      \fi
    \end{tikzpicture}%
    % Reserve body space: enough for the title block plus a small gap
    % below it. Multi-line and with-subtitle cases reserve more space.
    \ifdim\ht\@tempboxa>0.7cm
      \vbox to1.6cm{}%
    \else
      \ifx\insertframesubtitle\@empty
        \vbox to1.0cm{}%
      \else
        \vbox to1.4cm{}%
      \fi
    \fi
  \fi
}

% Centered frametitle variant: select with \setbeamertemplate{frametitle}[NLc]
% on a per-frame basis to horizontally centre both title and subtitle on the
% slide (not on the post-sidebar text area).
%
% The beamercolorbox starts at the frametitle template's natural left edge
% (slide-x = \beamer@leftsidebar) and is given
%     wd = \paperwidth - 2 \beamer@leftsidebar
% so its right edge sits at \paperwidth - \beamer@leftsidebar. The box is
% therefore symmetric about \paperwidth/2 (the slide's geometric centre),
% and content centred inside it lands exactly on the slide centre.
\defbeamertemplate*{frametitle}{NLc}[1][]{%
  \ifx\insertframetitle\@empty
    % No title: still reserve a small top margin so body doesn't crash
    % into the top edge.
    \vbox to0.4cm{}%
  \else
    \setbox\@tempboxa=\vbox{%
      \hsize=\dimexpr\paperwidth-2\beamer@leftsidebar\relax
      \usebeamerfont{frametitle}\noindent\insertframetitle\par
    }%
    \begin{tikzpicture}[remember picture,overlay]
      \ifdim\ht\@tempboxa>0.7cm
        % Multi-line title: anchor first line ~0.2 cm from slide top
        % (half a cap height above the single-line anchor).
        \node[anchor=north,inner sep=0pt,
              text width=\dimexpr\paperwidth-2\beamer@leftsidebar\relax,
              align=center]
          at ([yshift=-0.2cm]current page.north)
          {\usebeamercolor[fg]{frametitle}\usebeamerfont{frametitle}\insertframetitle};
      \else
        \ifx\insertframesubtitle\@empty
          % Single line, no subtitle: cap top at logo top (~0.3 mm).
          \node[anchor=north,inner sep=0pt,
                text width=\dimexpr\paperwidth-2\beamer@leftsidebar\relax,
                align=center]
            at ([yshift=-3mm]current page.north)
            {\usebeamercolor[fg]{frametitle}\usebeamerfont{frametitle}\insertframetitle};
        \else
          % Single line with subtitle: lift title to ~0.2 cm; subtitle
          % anchored ~0.85 cm from slide top so the gap is ~half a
          % subtitle-line tall.
          \node[anchor=north,inner sep=0pt,
                text width=\dimexpr\paperwidth-2\beamer@leftsidebar\relax,
                align=center]
            at ([yshift=-0.2cm]current page.north)
            {\usebeamercolor[fg]{frametitle}\usebeamerfont{frametitle}\insertframetitle};
          \node[anchor=north,inner sep=0pt,
                text width=\dimexpr\paperwidth-2\beamer@leftsidebar\relax,
                align=center]
            at ([yshift=-0.85cm]current page.north)
            {\usebeamercolor[fg]{framesubtitle}\usebeamerfont{framesubtitle}\insertframesubtitle};
        \fi
      \fi
    \end{tikzpicture}%
    % Reserve body space: enough for the title block plus a small gap
    % below it. Multi-line and with-subtitle cases reserve more space.
    \ifdim\ht\@tempboxa>0.7cm
      \vbox to1.6cm{}%
    \else
      \ifx\insertframesubtitle\@empty
        \vbox to1.0cm{}%
      \else
        \vbox to1.4cm{}%
      \fi
    \fi
  \fi
}

% Footline templates
\defbeamertemplate*{footline}{NLTitle}[1][]{%Empty footline for title page
}

\defbeamertemplate*{footline}{NL}[1][]{%Footline for slide without CC
  \urlstyle{same}
    \hbox{%
        \ifx&#1&%
       % #1 is empty
       \hspace{0.75\paperwidth}
    \else
       % #1 is nonempty
    \hspace{0.25\paperwidth}
   \parbox{.50\paperwidth}{
   	\begin{centering}
   		\vbox to0.5cm{\vfil{\usebeamercolor[fg]{footline}\usebeamerfont{footline} #1}\vfil}%
	\end{centering}
    }%
    \fi
    \begin{beamercolorbox}[wd=.1\paperwidth,ht=.5cm,dp=.2cm,center]{date in head/foot}
        \usebeamerfont{date in head/foot}\insertshortdate{}
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.10\paperwidth,ht=.5cm,dp=.2cm,right,rightskip=4ex]{page number in head/foot}%
        \usebeamerfont{page number in head/foot}\insertframenumber / \inserttotalframenumber
    \end{beamercolorbox}%
    }
}

